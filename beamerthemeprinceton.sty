\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeprinceton}[2026/06/15 Princeton University Theme (standalone, no metropolis)]

% =====================================================================
%  Princeton beamer theme -- standalone (does NOT load metropolis)
%  Design goals:
%   * PowerPoint-like sans-serif font (Carlito = Calibri metric clone)
%   * Frame titles: Princeton orange text, NO background bar
%   * Tight content indentation
% =====================================================================

% ---- Required packages ----------------------------------------------
\RequirePackage[normalem]{ulem}
\RequirePackage{tikz}

% ---- Fonts: PowerPoint-like (Carlito mimics Calibri) ----------------
\RequirePackage[sfdefault]{carlito}
\renewcommand{\familydefault}{\sfdefault}

% ---- Colors ---------------------------------------------------------
% Princeton orange, darkened from the logo's #ED6D0B for contrast on white.
% The logo hue itself is kept in princetonlogo for anything that must match the
% shield exactly.
\definecolor{princeton}{RGB}{194,85,8}
\definecolor{princetonlogo}{RGB}{237,109,11}
\definecolor{princetonink}{RGB}{38,38,38}    % near-black body text
\definecolor{princetonmute}{RGB}{120,120,120}% muted gray (footer, shaded)
\colorlet{accentcolor}{princeton}

\setbeamercolor{normal text}{fg=princetonink, bg=white}
\setbeamercolor{background canvas}{bg=white}
\setbeamercolor{alerted text}{fg=princeton}
\setbeamercolor{structure}{fg=princeton}

\setbeamercolor{title}{fg=princeton}
\setbeamercolor{subtitle}{fg=princetonink}
\setbeamercolor{author}{fg=princetonink}
\setbeamercolor{date}{fg=princetonmute}
\setbeamercolor{institute}{fg=princetonink}

% Frame title: orange text, NO background fill
\setbeamercolor{frametitle}{fg=princeton, bg=}

% ---- Font sizes / weights -------------------------------------------
\setbeamerfont{title}{size=\LARGE, series=\bfseries}
\setbeamerfont{subtitle}{size=\large, series=\mdseries}
\setbeamerfont{frametitle}{size=\Large, series=\bfseries}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{date}{size=\small}
\setbeamerfont{footline}{size=\scriptsize}

% ---- Margins: tighter content indentation ---------------------------
\newlength{\princeton@margin}
\setlength{\princeton@margin}{0.55cm}
\setbeamersize{text margin left=\princeton@margin, text margin right=\princeton@margin}

% Reduce itemize/enumerate indentation
\setlength{\leftmargini}{1.3em}
\setlength{\leftmarginii}{1.1em}
\setlength{\leftmarginiii}{1.0em}

% No navigation symbols
\setbeamertemplate{navigation symbols}{}

% Reserve breathing room above the frame title
\setbeamertemplate{headline}{\vskip0.55cm}

% =====================================================================
%  FRAME TITLE  (orange text, thin orange underline, no bar)
% =====================================================================
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth, sep=0pt,
      leftskip=\princeton@margin, rightskip=\princeton@margin]{frametitle}%
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}%
    \par\nointerlineskip\vspace*{1ex}%
    {\color{princeton}\rule{\dimexpr\paperwidth-2\princeton@margin\relax}{1pt}}%
  \end{beamercolorbox}%
}

% =====================================================================
%  TITLE PAGE
% =====================================================================
\setbeamertemplate{title separator}{%
  \par\noindent{\color{princeton}\rule{\textwidth}{1pt}}\par%
}

\setbeamertemplate{title page}{%
  % Frame is bottom-aligned ([b]); beamer's top \fill + the \vfill before the
  % logo centre the title block while pinning the logo to the very bottom.
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
  \ifx\insertsubtitle\@empty\else
    \vspace*{0.45em}%
    {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
  \fi
  % Even whitespace above/below the separator rule (inlined for precise control).
  \vspace*{0.85em}%
  {\color{princeton}\rule{\textwidth}{1pt}}\par%
  \vspace*{0.85em}%
  {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}%
  \ifx\insertdate\@empty\else
    \vspace*{0.15em}%
    {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}%
  \fi
  \vfill
  % Anchor the institute / title graphic at the very bottom-right.
  \begin{flushright}
    \ifx\inserttitlegraphic\@empty
      \ifx\insertinstitute\@empty\else\insertinstitute\fi
    \else
      \inserttitlegraphic
    \fi
  \end{flushright}
  \vspace*{2mm}%
}

% =====================================================================
%  FOOTLINE  (short title  |  frame number  |  logo)
% =====================================================================
\setbeamercolor{footline text}{fg=princetonmute}
\setbeamertemplate{footline}{%
  \usebeamerfont{footline}%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.40\paperwidth, ht=4.5ex, dp=2.5ex, left,
        leftskip=\princeton@margin]{footline text}%
      \color{princetonmute}$\vcenter{\hbox{\insertshorttitle}}$%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.20\paperwidth, ht=4.5ex, dp=2.5ex, center]{footline text}%
      \color{princetonmute}$\vcenter{\hbox{\insertframenumber}}$%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.40\paperwidth, ht=4.5ex, dp=2.5ex, right,
        rightskip=\princeton@margin]{footline text}%
      $\vcenter{\hbox{\includegraphics[height=2.8ex]{logos/princeton_logo.pdf}}}$%
    \end{beamercolorbox}%
  }%
  \vskip0pt%
}

% =====================================================================
%  ITEMIZE / ENUMERATE
% =====================================================================
\setbeamertemplate{itemize item}{\small\raise0.3ex\hbox{\textbullet}}
\setbeamertemplate{itemize subitem}{\footnotesize\raise0.2ex\hbox{--}}
\setbeamertemplate{itemize subsubitem}{\textperiodcentered}
\setbeamercolor{itemize item}{fg=princeton}
\setbeamercolor{itemize subitem}{fg=princeton}
\setbeamercolor{enumerate item}{fg=princeton}

% =====================================================================
%  BLOCKS  (rounded, subtle Princeton tint)
% =====================================================================
\definecolor{princetontintbg}{RGB}{250,248,246}
\colorlet{princeton@blocktitlebg}{accentcolor!16!princetontintbg}
\colorlet{princeton@blocktitlefg}{accentcolor!92!black}
\colorlet{princeton@blockbodybg}{accentcolor!5!princetontintbg}
\setbeamercolor{block title}{fg=princeton@blocktitlefg, bg=princeton@blocktitlebg}
\setbeamercolor{block body}{fg=princetonink, bg=princeton@blockbodybg}
\setbeamercolor{block title alerted}{fg=princeton@blocktitlefg, bg=accentcolor!22!princetontintbg}
\setbeamercolor{block body alerted}{fg=princetonink, bg=princeton@blockbodybg}
\setbeamercolor{block title example}{fg=princeton@blocktitlefg, bg=accentcolor!18!princetontintbg}
\setbeamercolor{block body example}{fg=princetonink, bg=princeton@blockbodybg}
\setbeamerfont{block title}{series=\bfseries}
\setbeamertemplate{blocks}[rounded][shadow=false]

% Inner padding for rounded blocks
\makeatletter
\newlength{\princeton@blockhpad}
\newlength{\princeton@blockvpad}
\setlength{\princeton@blockhpad}{1.2ex}
\setlength{\princeton@blockvpad}{0.4ex}

\def\princeton@blockbegin#1#2{%
  \par\vskip\medskipamount%
  \begin{beamerboxesrounded}[upper=#1,lower=#2,shadow=false,width=\textwidth]{%
    \usebeamerfont*{#1}%
    \vspace*{\princeton@blockvpad}%
    \hspace*{\princeton@blockhpad}\insertblocktitle\hspace*{\princeton@blockhpad}%
    \vspace*{\princeton@blockvpad}%
  }%
  \begingroup%
  \vspace*{\princeton@blockvpad}%
  \leftskip=\princeton@blockhpad%
  \rightskip=\princeton@blockhpad%
}
\def\princeton@blockend{%
  \par\vspace*{\princeton@blockvpad}%
  \endgroup%
  \end{beamerboxesrounded}%
  \vskip\smallskipamount%
}
\setbeamertemplate{block begin}{\princeton@blockbegin{block title}{block body}}
\setbeamertemplate{block end}{\princeton@blockend}
\setbeamertemplate{block alerted begin}{\princeton@blockbegin{block title alerted}{block body alerted}}
\setbeamertemplate{block alerted end}{\princeton@blockend}
\setbeamertemplate{block example begin}{\princeton@blockbegin{block title example}{block body example}}
\setbeamertemplate{block example end}{\princeton@blockend}
\makeatother

% =====================================================================
%  TABLE OF CONTENTS  (outline) hierarchy
% =====================================================================
\setbeamertemplate{section in toc}{%
  \leavevmode%
  {\usebeamerfont{section in toc}%
   \inserttocsectionnumber.\enspace\inserttocsection\par}%
}
\setbeamertemplate{section in toc shaded}{%
  \leavevmode%
  {\usebeamerfont{section in toc}%
   \textcolor{princetonmute}{\inserttocsectionnumber.}\enspace%
   \textcolor{princetonmute}{\inserttocsection}\par}%
}
\setbeamertemplate{subsection in toc}{%
  \leavevmode\leftskip=1.5em%
  {\usebeamerfont{subsection in toc}%
   \textcolor{princeton}{\raisebox{0.2ex}{\scriptsize\textbullet}}\hskip0.7em%
   \inserttocsubsection\par}%
}
\setbeamertemplate{subsection in toc shaded}{%
  \leavevmode\leftskip=1.5em%
  {\usebeamerfont{subsection in toc}%
   \textcolor{princetonmute}{\raisebox{0.2ex}{\scriptsize\textbullet}}\hskip0.7em%
   \textcolor{princetonmute}{\inserttocsubsection}\par}%
}
\setbeamerfont{section in toc}{size=\normalsize, series=\bfseries}
\setbeamerfont{subsection in toc}{size=\small, series=\mdseries}
% Entry names read as body text; the orange stays on the number and bullet only.
% (Both default to parent=structure, i.e. orange, so this has to be explicit.)
\setbeamercolor{section in toc}{fg=princetonink}
\setbeamercolor{subsection in toc}{fg=princetonink}

\AtBeginSection{%
  \begin{frame}{Outline}
    \tableofcontents[currentsection]
  \end{frame}%
}

% =====================================================================
%  custom emph tcolorbox environment  (requires tcolorbox in preamble)
% =====================================================================
\newenvironment{emphbox}[1][]{%
  \begin{tcolorbox}[colback=princeton!5,colframe=princeton!70!black,boxrule=1pt]%
    \begin{center}%
      \if\relax\detokenize{#1}\relax\else#1\par\medskip\fi
}{%
    \end{center}%
  \end{tcolorbox}%
}
